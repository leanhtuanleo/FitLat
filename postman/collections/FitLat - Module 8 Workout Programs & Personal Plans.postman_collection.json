    {
      "name": "02 - Workout Program Templates",
      "item": [
        {
          "name": "Create Workout Program",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst data = pm.response.json();\r\n\r\nif (data.id !== undefined) {\r\n    pm.collectionVariables.set(\"programId\", String(data.id));\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"nameVi\": \"Chương trình tập toàn thân 3 buổi\",\r\n  \"nameEn\": \"Full Body Beginner 3 Days\",\r\n  \"description\": \"Chương trình toàn thân dành cho người mới bắt đầu, tập 3 buổi mỗi tuần.\",\r\n  \"difficulty\": \"BEGINNER\",\r\n  \"durationWeeks\": 4,\r\n  \"daysPerWeek\": 3,\r\n  \"exercises\": [\r\n    {\r\n      \"exerciseId\": 2,\r\n      \"dayNumber\": 1,\r\n      \"orderIndex\": 1,\r\n      \"targetSets\": 3,\r\n      \"repsMin\": 8,\r\n      \"repsMax\": 12,\r\n      \"restSeconds\": 90,\r\n      \"notes\": \"Bài tập đầu tiên\"\r\n    },\r\n    {\r\n      \"exerciseId\": 3,\r\n      \"dayNumber\": 1,\r\n      \"orderIndex\": 2,\r\n      \"targetSets\": 3,\r\n      \"repsMin\": 10,\r\n      \"repsMax\": 12,\r\n      \"restSeconds\": 60,\r\n      \"notes\": \"Bài tập thứ hai\"\r\n    },\r\n    {\r\n      \"exerciseId\": 4,\r\n      \"dayNumber\": 2,\r\n      \"orderIndex\": 1,\r\n      \"targetSets\": 3,\r\n      \"repsMin\": 8,\r\n      \"repsMax\": 12,\r\n      \"restSeconds\": 90,\r\n      \"notes\": \"Bài tập ngày thứ hai\"\r\n    }\r\n  ]\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
