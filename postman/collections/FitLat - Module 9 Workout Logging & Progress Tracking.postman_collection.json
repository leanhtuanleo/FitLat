        {
          "name": "03.3 - Add second set log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"HTTP status is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\nconst data = pm.response.json();\n\nlet logId = data.id;\nlet log = null;\n\n// Nếu response trả về WorkoutSession\nif (logId == null) {\n    const sessionExerciseId =\n        pm.environment.get(\"sessionExerciseId\") ||\n        pm.collectionVariables.get(\"sessionExerciseId\");\n\n    const exercises = data.exercises || [];\n\n    const exercise = exercises.find(\n        e => String(e.id) === String(sessionExerciseId)\n    );\n\n    const logs = exercise?.setLogs || [];\n\n    log = logs.find(s => Number(s.setNumber) === 2);\n\n    logId = log?.id;\n}\n\npm.test(\"Second set log was created\", function () {\n    pm.expect(logId).to.not.be.undefined;\n    pm.expect(logId).to.not.be.null;\n});\n\nif (logId != null) {\n    pm.environment.set(\"secondSetLogId\", String(logId));\n}\n"
                ]
