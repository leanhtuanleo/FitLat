                  "});",
                  "",
                  "let data = pm.response.json();",
                  "let exercises = data.exercises || [];",
                  "if (exercises.length > 0 && exercises[0].id != null) {",
                  "    if (pm.environment.name) pm.environment.set(\"sessionExerciseId\", String(exercises[0].id));",
                  "    else pm.collectionVariables.set(\"sessionExerciseId\", String(exercises[0].id));",
                  "}",
                  "pm.test(\"Session contains the added exercise\", function () {",
                  "    pm.expect(exercises.length).to.be.greaterThan(0);",
                  "});"
