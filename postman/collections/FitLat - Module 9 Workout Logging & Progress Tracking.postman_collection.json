    {
      "name": "03 - Set Logging",
      "item": [
        {
          "name": "03.1 - Add first set log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\npm.test(\"HTTP status is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\nconst data = pm.response.json();\n\nlet logId = data.id;\n\n// Nếu response trả về WorkoutSession chứa exercises và setLogs\nif (logId == null) {\n    const sessionExerciseId =\n        pm.environment.get(\"sessionExerciseId\") ||\n        pm.collectionVariables.get(\"sessionExerciseId\");\n\n    const exercises = data.exercises || [];\n\n    const exercise = exercises.find(\n        e => String(e.id) === String(sessionExerciseId)\n    );\n\n    const logs = exercise?.setLogs || [];\n\n    const log = logs.find(s => Number(s.setNumber) === 1)\n        || logs[logs.length - 1];\n\n    logId = log?.id;\n}\n\npm.test(\"Set log ID is available\", function () {\n    pm.expect(logId).to.not.be.undefined;\n    pm.expect(logId).to.not.be.null;\n});\n\nif (logId != null) {\n    pm.environment.set(\"setLogId\", String(logId));\n}\n\n"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"setNumber\": 1,\n  \"reps\": 10,\n  \"weightKg\": 40.0,\n  \"durationSeconds\": null,\n  \"distanceMeters\": null,\n  \"rpe\": 7.0,\n  \"notes\": \"First working set\"\n}",
              "options": {
